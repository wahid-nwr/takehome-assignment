{
  "name": "multi-tenant-feature-flag-service",
  "version": "1.0.0",
  "description": "Multi-tenant configuration and feature flag service (take-home project)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "node dist/migrate.js",
    "lint": "eslint src tests",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci:validate": "npm run typecheck && npm run lint && npm run test:coverage",
    "ci:build": "npm run build",
    "performance:test": "docker run --rm -i --network host -v $(pwd):/workspace -w /workspace -e API_KEY=$API_KEY grafana/k6 run tests/performance/evaluate.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "morgan": "^1.10.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "eslint": "^9.39.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.37.0"
  }
}
