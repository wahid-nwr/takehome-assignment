NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/feature_flags

REDIS_URL=redis://redis:6379

CACHE_ENABLED=true
CACHE_TTL=300

LOG_LEVEL=info

ENABLE_SWAGGER=true
ENABLE_REQUEST_LOGGING=true

API_VERSION=v1

# Administrative API key used to create new tenants.
SERVICE_API_KEY=change-me